@model EquipmentIndexViewModel
@{
    ViewData["Title"] = "Equipment";
    var isAdmin = User.IsInRole(OutdoorRental.Data.DbSeeder.AdminRole);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Equipment</h1>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">+ New equipment</a>
    }
</div>

<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-md-6">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Search by name, inventory number or description" />
    </div>
    <div class="col-md-4">
        <select name="categoryId" asp-items="@(new SelectList(Model.Categories, "Value", "Text", Model.CategoryId))" class="form-select">
            <option value="">All categories</option>
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">No equipment matches the criteria.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Inventory no.</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th class="text-end">Year</th>
                    <th class="text-end">Daily cost</th>
                    <th class="text-end">Units (available)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Items)
                {
                    <tr>
                        <td><code>@e.InventoryNumber</code></td>
                        <td><a asp-action="Details" asp-route-id="@e.Id">@e.Name</a></td>
                        <td>@e.CategoryName</td>
                        <td class="text-end">@e.PurchaseYear</td>
                        <td class="text-end">@e.DailyRentalCost.ToString("N2") PLN</td>
                        <td class="text-end">@e.UnitCount (@e.AvailableCount)</td>
                        <td class="text-end text-nowrap">
                            @if (isAdmin)
                            {
                                <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@e.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
