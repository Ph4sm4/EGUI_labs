@model EquipmentFormViewModel
@{
    ViewData["Title"] = "Edit equipment";
}

<h1 class="h3 mb-4">Edit equipment</h1>

<form asp-action="Edit" method="post" style="max-width: 760px">
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" model="Model" />
    <p class="form-text">Individual units (adding, moving between rental points, removing) are managed on the
        <a asp-action="Details" asp-route-id="@Model.Id">details page</a>.</p>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
</form>
