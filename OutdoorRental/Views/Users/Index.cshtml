@model List<UserListItemViewModel>
@{
    ViewData["Title"] = "Users";
}

<h1 class="h3 mb-4">Users</h1>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th class="text-end">Balance</th>
                <th>Role</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.FullName</td>
                    <td>@u.Email</td>
                    <td>@u.PhoneNumber</td>
                    <td class="text-end">@u.Balance.ToString("N2") PLN</td>
                    <td>
                        @if (u.IsAdmin)
                        {
                            <span class="badge bg-warning text-dark">Admin</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Customer</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Edit details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
