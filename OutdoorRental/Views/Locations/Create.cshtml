@model RentalLocation
@{
    ViewData["Title"] = "New rental point";
}

<h1 class="h3 mb-4">New rental point</h1>

<form asp-action="Create" method="post" class="form-narrow">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
