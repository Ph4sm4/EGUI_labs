@model Category
@{
    ViewData["Title"] = "Categories";
    var categories = (List<CategoryListItemViewModel>)ViewBag.Categories;
    // controller sets this when adding failed, so the modal shows up already open
    var openCreate = ViewBag.OpenCreateModal == true;
    if (openCreate)
    {
        ViewData["ModalOpen"] = true;
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Equipment categories</h1>
    @if (openCreate)
    {
        <a asp-action="Index" class="btn btn-primary">+ New category</a>
    }
    else
    {
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCategoryModal">+ New category</button>
    }
</div>

<table class="table table-hover" style="max-width: 760px">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th class="text-end">Equipment</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in categories)
        {
            <tr>
                <td>@c.Name</td>
                <td class="text-end">@c.EquipmentCount</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Rename</a>
                    @if (c.EquipmentCount == 0)
                    {
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@* new category modal, opened by the button up top *@
<div id="createCategoryModal" tabindex="-1" aria-labelledby="createCategoryModalLabel"
     class="modal fade @(openCreate ? "show d-block server-open" : "")"
     @(openCreate ? Html.Raw("role=\"dialog\" aria-modal=\"true\"") : Html.Raw("aria-hidden=\"true\""))>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form asp-action="Create" method="post">
                <div class="modal-header border-0 pb-0">
                    <h2 class="modal-title h4" id="createCategoryModalLabel">New category</h2>
                    @if (openCreate)
                    {
                        <a asp-action="Index" class="btn-close" aria-label="Close"></a>
                    }
                    else
                    {
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    }
                </div>
                <div class="modal-body">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="modal-footer border-0 pt-0">
                    @if (openCreate)
                    {
                        <a asp-action="Index" class="btn btn-link">Cancel</a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-link" data-bs-dismiss="modal">Cancel</button>
                    }
                    <button type="submit" class="btn btn-primary px-4">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>
@if (openCreate)
{
    <div class="modal-backdrop fade show server-open"></div>
}
